{
  "name": "psore-v5-decision-reporting",
  "version": "5.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:project": "node scripts/verify-project.mjs && node scripts/verify-v5-2.mjs",
