    "verify:render": "node scripts/verify-render-files.mjs",
    "storage:upload": "node scripts/upload-storage-assets.mjs"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
