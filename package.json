    "docx": "^8.5.0",
    "xlsx": "^0.18.5",
    "jspdf": "^2.5.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
